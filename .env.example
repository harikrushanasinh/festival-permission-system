# ---- App ----
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# ---- Database ----
DATABASE_URL=postgresql://festival_user:festival_pass@localhost:5432/festival_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=festival_user
DB_PASS=festival_pass
DB_NAME=festival_db

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- JWT ----
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ---- Google Maps ----
GOOGLE_MAPS_API_KEY=

# ---- Storage ----
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---- SMS / Email ----
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMS_API_KEY=

# ---- Frontend ----
FRONTEND_URL=http://localhost:4200
